                <ui:Label text="3" name="SlotNumber3"/>
                <ui:VisualElement name="IconCircle3" style="flex-grow: 1; width: 70px; height: 70px; border-top-left-radius: 35px; border-top-right-radius: 35px; border-bottom-right-radius: 35px; border-bottom-left-radius: 35px; border-left-color: rgb(31, 59, 109); border-right-color: rgb(31, 59, 109); border-top-color: rgb(31, 59, 109); border-bottom-color: rgb(31, 59, 109); align-items: center; justify-content: center; flex-direction: row;">
