        <ui:VisualElement name="SelectedPowerUpPanel" style="flex-grow: 1; width: 350px; height: 150px; margin-left: 12px; padding-left: 16px; padding-right: 16px; padding-top: 12px; padding-bottom: 12px; flex-direction: row; align-items: center; background-color: rgb(8, 26, 46); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom-right-radius: 18px; border-bottom-left-radius: 18px; border-left-color: rgb(22, 77, 145); border-right-color: rgb(22, 77, 145); border-top-color: rgb(22, 77, 145); border-bottom-color: rgb(22, 77, 145); flex-shrink: 0;">
